.env# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source exports of real applicant data (never commit; see docs/registration-form-spec.md)
/form.html
/form-export*.html


# local agent/tooling (per-machine, never commit)
/.agents/
/.claude/
/.omp/
/skills-lock.json

# supabase advisor scratch dumps + smoke-test temp files
advisors-*.json
shop-smoke-tmp.json
